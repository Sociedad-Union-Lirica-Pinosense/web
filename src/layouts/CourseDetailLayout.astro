---
import PageLayout from './PageLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../config/site';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  level?: string;
  ageRange?: string;
  icon?: string;
  lang?: Locale;
}

const { title, description, level, ageRange, icon, lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const prefix = lang === site.defaultLocale ? site.base : `${site.base}/${lang}`;
const schoolSlug = lang === 'es' ? 'escuela' : lang === 'va' ? 'escola' : 'school';
const schoolPath = `${prefix}/${schoolSlug}/`;
---

<PageLayout title={title} description={description} lang={lang}>
  <article class="container section">
    <Breadcrumb
      items={[
        { label: t('school.title'), href: schoolPath },
        { label: t('school.courses.title'), href: `${schoolPath}#ofertas` },
        { label: title },
      ]}
    />

    <header class="course-header">
      {icon && <span class="course-header-icon" aria-hidden="true">{icon}</span>}
      <h1>{title}</h1>
      <p class="course-header-desc">{description}</p>
      <div class="course-header-meta">
        {level && <span class="meta-badge">{level}</span>}
        {ageRange && <span class="meta-age">{ageRange}</span>}
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    <nav class="course-nav">
      <a href={`${schoolPath}#ofertas`} class="btn btn-outline">
        &larr; {t('school.courses.back')}
      </a>
    </nav>
  </article>
</PageLayout>

<style>
  .course-header {
    text-align: center;
    margin-block-end: var(--space-8);
  }
  .course-header-icon {
    font-size: var(--text-4xl);
    display: block;
    margin-block-end: var(--space-4);
  }
  .course-header h1 {
    margin-block-end: var(--space-3);
  }
  .course-header-desc {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    max-width: 60ch;
    margin-inline: auto;
    margin-block-end: var(--space-4);
  }
  .course-header-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }
  .meta-badge {
    background: var(--color-primary-soft);
    color: var(--color-primary-dark);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }
  .meta-age {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-4);
  }
  .course-nav {
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--color-border);
  }
</style>
