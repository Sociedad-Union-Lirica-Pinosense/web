---
import PageLayout from './PageLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../config/site';
import { site } from '../config/site';

interface Props {
  title: string;
  date: Date;
  author?: string;
  coverImage?: string;
  lang?: Locale;
}

const { title, date, author, coverImage, lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const newsPath = lang === 'es' ? `${site.base}/noticias/` : lang === 'va' ? `${site.base}/va/noticies/` : `${site.base}/en/news/`;

const dateFormatted = date.toLocaleDateString(lang === 'va' ? 'ca' : lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<PageLayout title={title} lang={lang}>
  <article class="container section">
    <Breadcrumb
      items={[
        { label: t('news.title'), href: newsPath },
        { label: title },
      ]}
    />

    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>
          {t('news.published')} {dateFormatted}
        </time>
        {author && <span class="post-author">— {author}</span>}
      </div>
    </header>

    {coverImage && (
      <img
        src={coverImage}
        alt=""
        class="post-cover"
        loading="lazy"
        decoding="async"
      />
    )}

    <div class="prose">
      <slot />
    </div>

    <nav class="post-nav">
      <a href={newsPath} class="btn btn-outline">
        &larr; {t('news.back')}
      </a>
    </nav>
  </article>
</PageLayout>

<style>
  .post-header {
    margin-block-end: var(--space-8);
  }
  .post-header h1 {
    margin-block-end: var(--space-3);
  }
  .post-meta {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }
  .post-author {
    margin-inline-start: var(--space-2);
  }
  .post-cover {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-block-end: var(--space-8);
  }
  .post-nav {
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--color-border);
  }
</style>
