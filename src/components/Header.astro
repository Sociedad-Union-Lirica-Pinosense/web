---
import { site, type Locale } from '../config/site';
import { useTranslations } from '../i18n/utils';
import LanguagePicker from './LanguagePicker.astro';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const prefix = lang === site.defaultLocale ? site.base : `${site.base}/${lang}`;
const schoolSlug = lang === 'es' ? 'escuela' : lang === 'va' ? 'escola' : 'school';
const newsSlug = lang === 'es' ? 'noticias' : lang === 'va' ? 'noticies' : 'news';

const navItems = [
  { label: t('nav.band'), href: `${prefix}/` },
  { label: t('nav.school'), href: `${prefix}/${schoolSlug}/` },
  { label: t('nav.news'), href: `${prefix}/${newsSlug}/` },
  { label: t('nav.contact'), href: `${prefix}/#contacto` },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href={`${prefix}/`} class="logo" aria-label={site.name}>
      <span class="logo-text">{site.shortName}</span>
    </a>

    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="main-nav"
      aria-label={t('nav.menu')}
    >
      <span class="hamburger" aria-hidden="true"></span>
    </button>

    <nav id="main-nav" class="main-nav" aria-label={t('nav.band')}>
      <ul class="nav-list" role="list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
      <LanguagePicker lang={lang} />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-surface);
    border-block-end: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }
  .logo {
    text-decoration: none;
    color: var(--color-primary-dark);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-md);
  }
  .logo:hover { color: var(--color-primary); }

  .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 101;
  }
  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-ink);
    transition: transform var(--transition-normal), opacity var(--transition-normal);
  }
  .hamburger { position: relative; }
  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .hamburger::before { top: -7px; }
  .hamburger::after { top: 7px; }

  .menu-toggle[aria-expanded="true"] .hamburger { background-color: transparent; }
  .menu-toggle[aria-expanded="true"] .hamburger::before {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] .hamburger::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  .main-nav {
    display: none;
    position: fixed;
    inset: 0;
    top: 60px;
    background-color: var(--color-surface);
    padding: var(--space-8) var(--space-4);
    flex-direction: column;
    gap: var(--space-6);
    z-index: 99;
  }
  .main-nav.open { display: flex; }

  .nav-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .nav-link {
    text-decoration: none;
    font-weight: var(--weight-semibold);
    font-size: var(--text-md);
    color: var(--color-ink);
    padding: var(--space-3) var(--space-2);
    min-height: 44px;
    display: flex;
    align-items: center;
    transition: color var(--transition-fast);
  }
  .nav-link:hover { color: var(--color-primary); }

  @media (min-width: 768px) {
    .menu-toggle { display: none; }
    .main-nav {
      display: flex;
      position: static;
      flex-direction: row;
      align-items: center;
      gap: var(--space-6);
      padding: 0;
      background: none;
    }
    .nav-list {
      flex-direction: row;
      gap: var(--space-6);
    }
    .nav-link { font-size: var(--text-sm); }
  }
</style>

<script>
  const toggle = document.querySelector('.menu-toggle') as HTMLElement | null;
  const nav = document.querySelector('.main-nav') as HTMLElement | null;

  function openMenu() {
    toggle?.setAttribute('aria-expanded', 'true');
    nav?.classList.add('open');
    nav?.removeAttribute('aria-hidden');
    // Focus first link in menu
    const firstLink = nav?.querySelector('a') as HTMLElement | null;
    firstLink?.focus();
  }

  function closeMenu() {
    toggle?.setAttribute('aria-expanded', 'false');
    nav?.classList.remove('open');
    // Only hide on mobile (check if toggle is visible)
    if (toggle && getComputedStyle(toggle).display !== 'none') {
      nav?.setAttribute('aria-hidden', 'true');
    }
    toggle?.focus();
  }

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    expanded ? closeMenu() : openMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('open')) {
      closeMenu();
    }

    // Focus trap: Tab cycles within open mobile menu
    if (e.key === 'Tab' && nav?.classList.contains('open')) {
      const focusable = nav.querySelectorAll<HTMLElement>('a, button');
      const allFocusable = [toggle, ...Array.from(focusable)].filter(Boolean) as HTMLElement[];
      const first = allFocusable[0];
      const last = allFocusable[allFocusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last?.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first?.focus();
      }
    }
  });

  // Set initial aria-hidden on mobile
  if (toggle && getComputedStyle(toggle).display !== 'none') {
    nav?.setAttribute('aria-hidden', 'true');
  }

  // Handle resize: remove aria-hidden on desktop
  window.addEventListener('resize', () => {
    if (toggle && getComputedStyle(toggle).display === 'none') {
      nav?.removeAttribute('aria-hidden');
    } else if (!nav?.classList.contains('open')) {
      nav?.setAttribute('aria-hidden', 'true');
    }
  });
</script>
