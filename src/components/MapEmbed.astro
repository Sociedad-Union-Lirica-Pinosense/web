---
import { site, type Locale } from '../config/site';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<div class="map-container" id="map-container">
  <div class="map-placeholder" id="map-placeholder">
    <div class="map-consent">
      <p class="map-consent-title">{t('cookies.title')}</p>
      <p class="map-consent-text">{t('cookies.text')}</p>
      <div class="map-consent-actions">
        <button class="btn btn-primary" id="map-accept">{t('cookies.accept')}</button>
        <a
          href={site.contact.googleMapsLinkUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          {t('cookies.link')}
        </a>
      </div>
    </div>
  </div>
  <iframe
    id="map-iframe"
    class="map-iframe"
    style="display:none"
    title={t('school.location.title')}
    width="600"
    height="450"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
</div>

<style>
  .map-container {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .map-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 350px;
    background: var(--color-paper);
    padding: var(--space-8);
  }
  .map-consent {
    max-width: 400px;
    text-align: center;
  }
  .map-consent-title {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-lg);
    color: var(--color-primary-dark);
    margin-block-end: var(--space-3);
  }
  .map-consent-text {
    color: var(--color-text-secondary);
    margin-block-end: var(--space-6);
  }
  .map-consent-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }
  .map-iframe {
    width: 100%;
    height: 400px;
    border: none;
  }
</style>

<script define:vars={{ embedUrl: site.contact.googleMapsEmbedUrl }}>
  const STORAGE_KEY = 'sulp-maps-consent';

  function loadMap() {
    const iframe = document.getElementById('map-iframe');
    const placeholder = document.getElementById('map-placeholder');
    if (iframe && placeholder) {
      iframe.setAttribute('src', embedUrl);
      iframe.style.display = 'block';
      placeholder.style.display = 'none';
    }
  }

  // Check existing consent
  if (localStorage.getItem(STORAGE_KEY) === 'accepted') {
    loadMap();
  }

  // Listen for accept
  document.getElementById('map-accept')?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'accepted');
    loadMap();
  });
</script>
