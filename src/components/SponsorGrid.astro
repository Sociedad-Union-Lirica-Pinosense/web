---
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../config/site';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const sponsors = (await getCollection('sponsors'))
  .filter((s) => s.data.active && !s.id.startsWith('_'))
  .sort((a, b) => b.data.weight - a.data.weight);
---

{sponsors.length > 0 && (
  <div class="sponsor-section">
    <div class="sponsor-grid">
      {sponsors.map((sponsor) => (
        <a
          href={sponsor.data.url}
          target="_blank"
          rel="noopener noreferrer"
          class="sponsor-link"
          aria-label={`${sponsor.data.name} — ${t('footer.sponsors').toLowerCase()}`}
        >
          <img
            src={sponsor.data.logo}
            alt={sponsor.data.alt || `${sponsor.data.name}`}
            class="sponsor-logo"
            loading="lazy"
            decoding="async"
            width="140"
            height="80"
          />
        </a>
      ))}
    </div>
  </div>
)}

<style>
  .sponsor-section {
    padding-block-end: var(--space-8);
    margin-block-end: var(--space-6);
    border-block-end: 1px solid rgba(255, 255, 255, 0.2);
  }
  .sponsor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-6);
    align-items: center;
    justify-items: center;
  }
  .sponsor-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    opacity: 0.7;
    transition: opacity var(--transition-fast);
  }
  .sponsor-link:hover { opacity: 1; }
  .sponsor-link:focus-visible {
    outline: 2px solid var(--color-primary-soft);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  .sponsor-logo {
    max-height: 60px;
    width: auto;
    object-fit: contain;
  }
</style>
