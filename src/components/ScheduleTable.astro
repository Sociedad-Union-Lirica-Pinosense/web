---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../config/site';
import scheduleData from '../data/semanal.json';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const days = [
  { key: 'monday', label: t('schedule.monday') },
  { key: 'tuesday', label: t('schedule.tuesday') },
  { key: 'wednesday', label: t('schedule.wednesday') },
  { key: 'thursday', label: t('schedule.thursday') },
  { key: 'friday', label: t('schedule.friday') },
] as const;

type DayKey = (typeof days)[number]['key'];

const getSlotValue = (slot: (typeof scheduleData.slots)[number], dayKey: DayKey) =>
  slot[dayKey as keyof typeof slot] as string;

const getRowSpan = (subject: string) => (subject === 'Banda Escuela' ? 3 : 2);

const getScheduleGroup = (subject: string) =>
  subject
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/\s+/g, '-')
    .replace(/[^a-z0-9-]/g, '')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');

const isCoveredByPreviousSlot = (slotIndex: number, dayKey: DayKey) =>
  scheduleData.slots.some((slot, previousIndex) => {
    if (previousIndex >= slotIndex) return false;

    const value = getSlotValue(slot, dayKey);
    return Boolean(value) && previousIndex + getRowSpan(value) > slotIndex;
  });

// Build mobile-friendly data: group by day
const dayCards = days.map((day) => ({
  label: day.label,
  slots: scheduleData.slots
    .filter((slot) => {
      const value = getSlotValue(slot, day.key);
      return value && value !== '';
    })
    .map((slot) => ({
      time: slot.time,
      subject: getSlotValue(slot, day.key),
    })),
}));
---

{/* Desktop table */}
<div class="schedule-desktop">
  <div class="schedule-wrapper">
    <table class="schedule-table">
      <caption>{t('schedule.caption')}</caption>
      <thead>
        <tr>
          <th scope="col">{t('schedule.time')}</th>
          {days.map((day) => (
            <th scope="col">{day.label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {scheduleData.slots.map((slot, slotIndex) => (
          <tr>
            <th scope="row" class="time-cell">{slot.time}</th>
            {days.map((day) => {
              const value = getSlotValue(slot, day.key);
              if (isCoveredByPreviousSlot(slotIndex, day.key)) return null;

              return (
                <td
                  rowspan={value ? getRowSpan(value) : undefined}
                  data-schedule-group={value ? getScheduleGroup(value) : undefined}
                  class:list={[{ empty: !value }]}
                >
                  {value || '—'}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

{/* Mobile cards */}
<div class="schedule-mobile">
  <p class="schedule-mobile-caption">{t('schedule.caption')}</p>
  <div class="schedule-cards">
    {dayCards.map((day) => (
      <div class="day-card">
        <h4 class="day-card-title">{day.label}</h4>
        {day.slots.length > 0 ? (
          <ul class="day-card-slots">
            {day.slots.map((slot) => (
              <li class="day-card-slot">
                <span class="slot-time">{slot.time}</span>
                <span class="slot-subject">{slot.subject}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="day-card-empty">—</p>
        )}
      </div>
    ))}
  </div>
</div>

<script>
  const scheduleCells = document.querySelectorAll<HTMLTableCellElement>('[data-schedule-group]');

  const setHighlightedGroup = (group: string, highlighted: boolean) => {
    document
      .querySelectorAll<HTMLTableCellElement>(`[data-schedule-group="${group}"]`)
      .forEach((cell) => cell.classList.toggle('is-highlighted', highlighted));
  };

  scheduleCells.forEach((cell) => {
    const group = cell.dataset.scheduleGroup;
    if (!group) return;

    cell.addEventListener('mouseenter', () => setHighlightedGroup(group, true));
    cell.addEventListener('mouseleave', () => setHighlightedGroup(group, false));
  });
</script>

<style>
  /* ── Desktop table (hidden on mobile) ── */
  .schedule-desktop {
    display: none;
  }
  @media (min-width: 768px) {
    .schedule-desktop { display: block; }
    .schedule-mobile { display: none; }
  }

  .schedule-wrapper {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
  }
  .schedule-table {
    width: 100%;
    border-collapse: collapse;
  }
  caption {
    padding: var(--space-4);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-md);
    color: var(--color-primary-dark);
    text-align: start;
    caption-side: top;
  }
  thead th {
    background-color: var(--color-primary);
    color: var(--color-text-on-primary);
    font-weight: var(--weight-semibold);
    font-size: var(--text-xs);
    padding: var(--space-3) var(--space-4);
    text-align: center;
    white-space: nowrap;
  }
  tbody th,
  tbody td {
    padding: var(--space-3) var(--space-4);
    border-block-end: 1px solid var(--color-border);
    font-size: var(--text-xs);
    text-align: center;
    vertical-align: middle;
  }
  tbody td {
    white-space: pre-line;
  }
  .time-cell {
    font-weight: var(--weight-semibold);
    white-space: nowrap;
    background-color: var(--color-paper);
    text-align: start;
  }
  tbody td.is-highlighted {
    background-color: var(--color-primary-soft);
  }
  .empty {
    color: var(--color-border);
  }

  /* ── Mobile cards ── */
  .schedule-mobile-caption {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-md);
    color: var(--color-primary-dark);
    margin-block-end: var(--space-4);
    text-align: center;
  }
  .schedule-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .day-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .day-card-title {
    background-color: var(--color-primary);
    color: var(--color-text-on-primary);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    text-align: center;
  }
  .day-card-slots {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .day-card-slot {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-block-end: 1px solid var(--color-border);
    align-items: center;
  }
  .day-card-slot:last-child {
    border-block-end: none;
  }
  .slot-time {
    font-weight: var(--weight-semibold);
    font-size: var(--text-xs);
    color: var(--color-primary-dark);
    white-space: nowrap;
    min-width: 110px;
  }
  .slot-subject {
    font-size: var(--text-xs);
    color: var(--color-text);
    white-space: pre-line;
  }
  .day-card-empty {
    padding: var(--space-3) var(--space-4);
    text-align: center;
    color: var(--color-border);
  }
</style>
