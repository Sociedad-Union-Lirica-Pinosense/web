---
import { site, type Locale } from '../config/site';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const membershipPaths: Record<Locale, string> = {
  es: 'hazte-socio',
  va: 'fes-te-soci',
  en: 'join-us',
};
const prefix = lang === site.defaultLocale ? '' : `${lang}/`;
const href = `${site.base}/${prefix}${membershipPaths[lang]}/`;
---

<section class="membership-cta" aria-labelledby="membership-cta-title">
  <div class="membership-inner">
    <div class="membership-gold-line" aria-hidden="true"></div>

    <h2 id="membership-cta-title" class="membership-title">{t('membership.title')}</h2>
    <p class="membership-subtitle">{t('membership.subtitle')}</p>
    <p class="membership-description">{t('membership.description')}</p>

    <div class="membership-contact-grid">
      <div class="membership-contact-card">
        <svg class="membership-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        <h3>{t('membership.contact.email')}</h3>
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </div>

      <div class="membership-contact-card">
        <svg class="membership-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        <h3>{t('membership.contact.phone')}</h3>
        <a href={`tel:${site.contact.phoneBand.replace(/\s/g, '')}`}>{site.contact.phoneBand}</a>
      </div>

      <div class="membership-contact-card">
        <svg class="membership-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        <h3>{t('membership.contact.visit')}</h3>
        <p>{t('membership.contact.visit.text')}</p>
      </div>
    </div>

    <a href={href} class="membership-btn">
      {t('membership.cta')}
      <svg class="membership-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </a>
  </div>
</section>

<style>
  .membership-cta {
    background-color: var(--color-primary);
    color: #fff;
    padding: var(--space-12) var(--space-4);
  }
  .membership-inner {
    max-width: 800px;
    margin-inline: auto;
    text-align: center;
  }
  .membership-gold-line {
    width: 80px;
    height: 3px;
    background-color: var(--color-accent-gold);
    margin: 0 auto var(--space-6);
    border-radius: 2px;
  }
  .membership-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-black);
    color: #fff;
    margin-block-end: var(--space-3);
    line-height: var(--leading-tight);
  }
  .membership-subtitle {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    opacity: 0.9;
    margin-block-end: var(--space-4);
  }
  .membership-description {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    opacity: 0.85;
    max-width: 600px;
    margin-inline: auto;
    margin-block-end: var(--space-8);
  }

  /* Contact grid */
  .membership-contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-block-end: var(--space-8);
  }
  @media (min-width: 640px) {
    .membership-contact-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .membership-contact-card {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    transition: background-color var(--transition-normal);
  }
  .membership-contact-card:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  .membership-contact-card h3 {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-gold);
    margin-block-end: var(--space-2);
  }
  .membership-contact-card a,
  .membership-contact-card p {
    color: #fff;
    font-size: var(--text-xs);
    text-decoration: none;
    opacity: 0.9;
    margin: 0;
  }
  .membership-contact-card a:hover {
    text-decoration: underline;
    opacity: 1;
  }
  .membership-icon {
    width: 28px;
    height: 28px;
    color: var(--color-accent-gold);
    margin-block-end: var(--space-3);
  }

  /* CTA Button */
  .membership-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: #fff;
    color: var(--color-primary-dark);
    font-weight: var(--weight-bold);
    font-size: var(--text-md);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }
  .membership-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }
  .membership-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .membership-btn-arrow {
    width: 18px;
    height: 18px;
    transition: transform var(--transition-normal);
  }
  .membership-btn:hover .membership-btn-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .membership-btn,
    .membership-btn:hover,
    .membership-btn-arrow,
    .membership-btn:hover .membership-btn-arrow,
    .membership-contact-card {
      transition: none;
      transform: none;
    }
  }
</style>
