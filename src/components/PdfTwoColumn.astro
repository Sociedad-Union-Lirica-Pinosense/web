---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../config/site';

interface Props {
  pdfs: Array<{ src: string; title: string }>;
  lang?: Locale;
}

const { pdfs, lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<div class="pdf-two-column">
  {pdfs.map((pdf) => (
    <div class="pdf-column">
      <h4 class="pdf-column-title">{pdf.title}</h4>
      <div class="pdf-frame">
        <object data={pdf.src} type="application/pdf" title={pdf.title} aria-label={`${pdf.title} — PDF`} class="pdf-object">
          <p>{t('pdf.noSupport')}</p>
        </object>
      </div>
      <a href={pdf.src} download class="btn btn-outline pdf-download">
        {t('pdf.download')}
      </a>
    </div>
  ))}
</div>

<style>
  .pdf-two-column {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  .pdf-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .pdf-column-title {
    font-size: var(--text-sm);
    text-align: center;
  }
  .pdf-frame {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface);
  }
  .pdf-object {
    width: 100%;
    height: 500px;
    display: block;
    border: none;
  }
  @media (max-width: 767px) {
    .pdf-object { height: 400px; }
  }
  .pdf-download {
    align-self: center;
    font-size: var(--text-sm);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
</style>
