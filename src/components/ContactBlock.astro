---
import { site, type Locale } from '../config/site';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<div class="contact-block" id="contacto">
  <div class="contact-grid">
    <div class="contact-card">
      <h3>{t('band.contact.hire')}</h3>
      <dl class="contact-list">
        <div class="contact-item">
          <dt>{t('band.contact.email')}</dt>
          <dd>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </dd>
        </div>
        <div class="contact-item">
          <dt>{t('band.contact.phone')}</dt>
          <dd>
            <a href={`tel:${site.contact.phoneBand.replace(/\s/g, '')}`}>
              {site.contact.phoneBand}
            </a>
          </dd>
        </div>
      </dl>
    </div>

    <div class="contact-card">
      <h3>{t('band.contact.hours')}</h3>
      <p class="hours-text">{site.hours.secretariatBand[lang]}</p>
      <address class="contact-address">
        {site.contact.address.street}<br />
        {site.contact.address.postalCode} {site.contact.address.city}<br />
        {site.contact.address.province}, {site.contact.address.country}
      </address>
    </div>
  </div>
</div>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 768px) {
    .contact-grid { grid-template-columns: 1fr 1fr; }
  }
  .contact-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }
  .contact-card h3 {
    margin-block-end: var(--space-4);
    font-size: var(--text-lg);
  }
  .contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .contact-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .contact-item dt {
    font-weight: var(--weight-semibold);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .contact-item dd {
    margin: 0;
    font-size: var(--text-md);
  }
  .hours-text {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    margin-block-end: var(--space-4);
  }
  .contact-address {
    font-style: normal;
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
</style>
