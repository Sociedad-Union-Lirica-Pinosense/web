---
import { site } from '../config/site';

interface Props {
  image: string;
  alt: string;
  title: string;
  subtitle?: string;
  compact?: boolean;
}

const { image, alt, title, subtitle, compact = false } = Astro.props;
const loading = compact ? 'lazy' : 'eager';
const fetchpriority = compact ? undefined : 'high';
---

<section class:list={['hero', { 'hero--compact': compact }]}>
  <img
    src={image}
    alt={alt}
    class="hero-image"
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    sizes="100vw"
  />
  <div class="hero-overlay">
    <div class="container hero-content">
      <h1 class="hero-title">{title}</h1>
      {subtitle && <p class="hero-subtitle">{subtitle}</p>}
      <div class="hero-actions">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero--compact {
    min-height: 40vh;
  }
  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    aspect-ratio: 16 / 9;
  }
  .hero-overlay {
    position: relative;
    width: 100%;
    background: linear-gradient(
      to top,
      rgba(26, 18, 20, 0.85) 0%,
      rgba(26, 18, 20, 0.4) 60%,
      transparent 100%
    );
    padding-block: var(--space-24) var(--space-12);
  }
  .hero-content {
    color: var(--color-text-on-primary);
  }
  .hero-title {
    color: var(--color-text-on-primary);
    font-size: var(--text-3xl);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }
  @media (min-width: 768px) {
    .hero-title { font-size: var(--text-4xl); }
  }
  .hero-subtitle {
    font-size: var(--text-md);
    margin-block: var(--space-3);
    opacity: 0.9;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }
</style>
