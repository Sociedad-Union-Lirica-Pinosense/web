---
import { site, type Locale } from '../config/site';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<div class="language-picker">
  <span class="sr-only">{t('lang.select')}</span>
  <ul class="lang-list" role="list">
    {site.locales.map((locale) => (
      <li>
        {locale === lang ? (
          <span class="lang-current" aria-current="page">{t(`lang.${locale}` as any)}</span>
        ) : (
          <a href={getLocalizedPath(Astro.url.pathname, locale)} class="lang-link" hreflang={locale}>
            {t(`lang.${locale}` as any)}
          </a>
        )}
      </li>
    ))}
  </ul>
</div>

<style>
  .lang-list {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    font-size: var(--text-sm);
  }
  .lang-list li:not(:last-child)::after {
    content: '|';
    margin-inline-start: var(--space-1);
    color: var(--color-border);
  }
  .lang-link {
    text-decoration: none;
    color: var(--color-text-secondary);
    padding: var(--space-1) var(--space-2);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-sm);
  }
  .lang-link:hover {
    color: var(--color-primary);
  }
  .lang-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .lang-current {
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    padding: var(--space-1) var(--space-2);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
</style>
