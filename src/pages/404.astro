---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../config/site';
import { useTranslations } from '../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);
---

<PageLayout title={t('404.title')} lang={lang}>
  <div class="error-page container section">
    <h1>{t('404.title')}</h1>
    <p>{t('404.text')}</p>
    <a href={`${site.base}/`} class="btn btn-primary">{t('404.home')}</a>
  </div>
</PageLayout>

<style>
  .error-page {
    text-align: center;
    min-height: 50vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }
  .error-page h1 {
    font-size: var(--text-3xl);
  }
  .error-page p {
    color: var(--color-text-secondary);
    font-size: var(--text-md);
  }
</style>
