---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import SocialLinks from '../../components/SocialLinks.astro';

import MembershipCTA from '../../components/MembershipCTA.astro';
import { site } from '../../config/site';
import { useTranslations } from '../../i18n/utils';

const lang = 'va';
const t = useTranslations(lang);
---

<PageLayout
  title={t('nav.band')}
  description="Societat Unió Lírica Pinosense — Banda de música de Pinós, Alacant. Tradició musical des de 1890."
  lang={lang}
>
  <Hero
    image={`${site.base}/images/banda/hero.webp`}
    alt="Músics i director de la Societat Unió Lírica Pinosense"
    title={site.name}
    subtitle={t('hero.subtitle', { year: site.band.founded })}
  >
    <a href="#contacto" class="btn btn-primary">{t('hero.cta.contact')}</a>
    <a href={`${site.base}/va/escola/`} class="btn btn-outline" style="border-color:white;color:white">
      {t('hero.cta.school')}
    </a>
  </Hero>

  <Section id="redes" title={t('band.social.title')} background="soft">
    <SocialLinks size={28} />
  </Section>

  <Section id="historia" title={t('band.history.title')}>
    <div class="prose" style="margin-inline:auto">
      <p>
        La <strong>Societat Unió Lírica Pinosense</strong> va ser fundada l'any {site.band.founded}
        a la localitat de Pinós, província d'Alacant. Des dels seus inicis, la societat ha sigut un
        pilar fonamental de la vida cultural pinosenca, formant a generacions de músics i oferint
        concerts, passacarrers i actuacions en festivitats locals i regionals.
      </p>
      <p>
        Amb més d'un segle d'història, la nostra banda manté viva la tradició musical alhora que
        incorpora nous repertoris i tècniques. Actualment està composta per {site.band.musicians}
        músics sota la direcció de <strong>{site.band.director}</strong>.
      </p>
      <p>
        La societat compta a més amb una <a href={`${site.base}/va/escola/`}>escola de música</a> on
        es formen els futurs músics de la banda, des de la iniciació musical fins a la formació
        instrumental avançada.
      </p>
    </div>
  </Section>

  

  

  <MembershipCTA lang={lang} />

  <Section id="contacto" title={t('band.contact.title')} background="soft">
    <ContactBlock lang={lang} />
  </Section>
</PageLayout>


