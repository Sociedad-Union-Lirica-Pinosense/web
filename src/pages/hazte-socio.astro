---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import { site } from '../config/site';
import { useTranslations } from '../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);

const benefits = [
  { icon: 'music', titleKey: 'membership.benefit.1.title' as const, textKey: 'membership.benefit.1.text' as const },
  { icon: 'discount', titleKey: 'membership.benefit.2.title' as const, textKey: 'membership.benefit.2.text' as const },
  { icon: 'community', titleKey: 'membership.benefit.3.title' as const, textKey: 'membership.benefit.3.text' as const },
  { icon: 'education', titleKey: 'membership.benefit.4.title' as const, textKey: 'membership.benefit.4.text' as const },
  { icon: 'events', titleKey: 'membership.benefit.5.title' as const, textKey: 'membership.benefit.5.text' as const },
  { icon: 'legacy', titleKey: 'membership.benefit.6.title' as const, textKey: 'membership.benefit.6.text' as const },
];
---

<PageLayout
  title={t('membership.page.title')}
  description="Hazte socio de la Sociedad Unión Lírica Pinosense. Descubre todos los beneficios de pertenecer a nuestra familia musical."
  lang={lang}
>
  <Hero
    image={`${site.base}/images/banda/hero.jpg`}
    alt="Músicos de la Sociedad Unión Lírica Pinosense"
    title={t('membership.title')}
    subtitle={t('membership.subtitle')}
    compact
  />

  <Section id="intro" background="soft">
    <div class="intro-block">
      <p class="intro-text">{t('membership.page.intro')}</p>
    </div>
  </Section>

  <Section id="beneficios" title={t('membership.benefits.title')}>
    <div class="benefits-grid">
      {benefits.map((b) => (
        <div class="benefit-card">
          <div class="benefit-icon" aria-hidden="true">
            {b.icon === 'music' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" />
              </svg>
            )}
            {b.icon === 'discount' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" /><line x1="7" y1="7" x2="7.01" y2="7" />
              </svg>
            )}
            {b.icon === 'community' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            )}
            {b.icon === 'education' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c0 2 3 3 6 3s6-1 6-3v-5" />
              </svg>
            )}
            {b.icon === 'events' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01" />
              </svg>
            )}
            {b.icon === 'legacy' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
              </svg>
            )}
          </div>
          <h3 class="benefit-title">{t(b.titleKey)}</h3>
          <p class="benefit-text">{t(b.textKey)}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section id="contacto-socio" title={t('membership.contact.title')} background="soft">
    <p class="contact-intro">{t('membership.contact.text')}</p>
    <div class="contact-methods">
      <div class="method-card">
        <svg class="method-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        <h3>{t('membership.contact.email')}</h3>
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </div>
      <div class="method-card">
        <svg class="method-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        <h3>{t('membership.contact.phone')}</h3>
        <a href={`tel:${site.contact.phoneBand.replace(/\s/g, '')}`}>{site.contact.phoneBand}</a>
      </div>
      <div class="method-card">
        <svg class="method-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" />
        </svg>
        <h3>{t('membership.contact.visit')}</h3>
        <address class="method-address">
          {site.contact.address.street}<br />
          {site.contact.address.postalCode} {site.contact.address.city}<br />
          <span class="method-hours">{site.hours.secretariatBand[lang]}</span>
        </address>
      </div>
    </div>
  </Section>

  <div class="back-link-wrapper">
    <a href={`${site.base}/`} class="back-link">
      &larr; {t('membership.back')}
    </a>
  </div>
</PageLayout>

<style>
  /* Intro */
  .intro-block {
    max-width: 700px;
    margin-inline: auto;
    text-align: center;
  }
  .intro-text {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  /* Benefits grid */
  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: 900px;
    margin-inline: auto;
  }
  @media (min-width: 640px) {
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .benefits-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .benefit-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    text-align: center;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }
  .benefit-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .benefit-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto var(--space-4);
    color: var(--color-primary);
  }
  .benefit-icon svg {
    width: 100%;
    height: 100%;
  }
  .benefit-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-primary-dark);
    margin-block-end: var(--space-2);
  }
  .benefit-text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  /* Contact methods */
  .contact-intro {
    text-align: center;
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    margin-block-end: var(--space-6);
  }
  .contact-methods {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    max-width: 800px;
    margin-inline: auto;
  }
  @media (min-width: 640px) {
    .contact-methods {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .method-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    text-align: center;
    box-shadow: var(--shadow-sm);
  }
  .method-icon {
    width: 32px;
    height: 32px;
    color: var(--color-primary);
    margin-block-end: var(--space-3);
  }
  .method-card h3 {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    color: var(--color-primary-dark);
    margin-block-end: var(--space-2);
  }
  .method-card a {
    color: var(--color-text);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .method-card a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .method-address {
    font-style: normal;
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
  }
  .method-hours {
    display: block;
    margin-block-start: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  /* Back link */
  .back-link-wrapper {
    text-align: center;
    padding: var(--space-8) var(--space-4);
  }
  .back-link {
    color: var(--color-primary);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }
  .back-link:hover {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .benefit-card,
    .benefit-card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
