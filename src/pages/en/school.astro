---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import CourseCard from '../../components/CourseCard.astro';
import PdfTwoColumn from '../../components/PdfTwoColumn.astro';
import PdfEmbed from '../../components/PdfEmbed.astro';
import ScheduleTable from '../../components/ScheduleTable.astro';
import NewsExpandable from '../../components/NewsExpandable.astro';
import { getCollection } from 'astro:content';
import { site } from '../../config/site';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

const courses = (await getCollection('courses'))
  .filter((c) => c.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);

const normativas = [
  { src: `${site.base}/pdfs/normativa-general.pdf`, title: 'General Regulations' },
  { src: `${site.base}/pdfs/normativa-interna.pdf`, title: 'Internal Regulations' },
];
---

<PageLayout
  title={t('school.title')}
  description="Music School of the Sociedad Unión Lírica Pinosense — Courses, schedules, regulations and school calendar."
  lang={lang}
>
  <Hero
    image={`${site.base}/images/escuela/fachada.webp`}
    alt="Music School building in Pinoso"
    title={t('school.title')}
    compact
  />

  <Section id="school-news" title={t('school.news.title')}>
    <NewsExpandable lang={lang} limit={3} />
  </Section>

  <Section id="location" title={t('school.location.title')} background="soft">
    <MapEmbed lang={lang} />
  </Section>

  <Section id="courses" title={t('school.courses.title')}>
    <div class="courses-grid">
      {courses.map((course) => {
        const slug = course.id.replace('en/', '').replace(/\.md$/, '');
        return (
          <CourseCard
            title={course.data.title}
            description={course.data.description}
            level={course.data.level}
            ageRange={course.data.ageRange}
            icon={course.data.icon}
            href={`${site.base}/en/school/course/${slug}/`}
            lang={lang}
          />
        );
      })}
    </div>
  </Section>

  <Section id="office-hours" title={t('school.hours.title')} background="soft">
    <div class="hours-block">
      <p class="hours-text">{site.hours.secretariatSchool[lang]}</p>
      <p class="hours-contact">
        <a href={`tel:${site.contact.phoneSchool.replace(/\s/g, '')}`}>{site.contact.phoneSchool}</a>
        &nbsp;·&nbsp;
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </p>
    </div>
  </Section>

  <Section id="calendar" title={t('school.calendar.title')}>
    <PdfEmbed
      src={`${site.base}/pdfs/calendario-escolar.pdf`}
      title="School Calendar"
      downloadLabel={t('school.calendar.download')}
      lang={lang}
    />
  </Section>

  <Section id="weekly-schedule" title={t('school.schedule.title')} background="soft">
    <ScheduleTable lang={lang} />
  </Section>

  <Section id="regulations" title={t('school.regulations.title')}>
    <PdfTwoColumn pdfs={normativas} lang={lang} />
  </Section>
</PageLayout>

<style>
  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
  }
  .hours-block {
    text-align: center;
    max-width: 500px;
    margin-inline: auto;
  }
  .hours-text {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-primary-dark);
    margin-block-end: var(--space-4);
  }
  .hours-contact { font-size: var(--text-md); }
</style>
