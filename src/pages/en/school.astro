---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import ScheduleTable from '../../components/ScheduleTable.astro';
import NewsExpandable from '../../components/NewsExpandable.astro';
import MembershipCTA from '../../components/MembershipCTA.astro';
import { site } from '../../config/site';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
---

<PageLayout
  title={t('school.title')}
  description="Music School of the Sociedad Unión Lírica Pinosense — Courses, schedules, enrolment and school calendar."
  lang={lang}
>
  <Hero
    image={`${site.base}/images/escuela/fachada.webp`}
    alt="Music School building in Pinoso"
    title={t('school.title')}
    compact
  />

  <Section id="school-news" title={t('school.news.title')}>
    <NewsExpandable lang={lang} limit={1} />
  </Section>

  <Section id="courses" title={t('school.courses.title')}>
    <div class="school-infographic">
      <img
        src={`${site.base}/images/escuela/oferta-formativa-2026-2027-en.png`}
        alt="Infographic showing the structure of the Sociedad Unión Lírica Pinosense Music School for the 2026/2027 course"
        loading="lazy"
        decoding="async"
      />
    </div>
  </Section>

  <Section id="enrolment" title="Enrolment and calendar Course 26-27" background="soft">
    <div class="document-cards">
      <div class="document-card">
        <p>
          Check all the enrolment information for the 2026/2027 course.
        </p>
        <a
          href={`${site.base}/pdfs/matricula-curso-26-27.pdf`}
          class="btn btn-outline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open enrolment information
        </a>
      </div>

      <div class="document-card">
        <p>
          Check the school calendar for the 2026/2027 course.
        </p>
        <a
          href={`${site.base}/pdfs/calendario-escolar-2026-2027.pdf`}
          class="btn btn-outline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open 2026/2027 calendar
        </a>
      </div>

      <div class="document-card">
        <p>
          View the current School Educational Project for the Music School.
        </p>
        <a
          href={`${site.base}/pdfs/proyecto-educativo-centro-2025-2026.pdf`}
          class="btn btn-outline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open School Educational Project
        </a>
      </div>

      <div class="document-card">
        <p>
          View the Music School's Annual General Plan for the 2025/2026 school year.
        </p>
        <a
          href={`${site.base}/pdfs/programacion-general-anual-2025-2026.pdf`}
          class="btn btn-outline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open Annual General Plan
        </a>
      </div>
    </div>
  </Section>

  <Section id="office-hours" title={t('school.hours.title')} background="soft">
    <div class="hours-block">
      <p class="hours-text">{site.hours.secretariatSchool[lang]}</p>
      <p class="hours-contact">
        <a href={`tel:${site.contact.phoneSchool.replace(/\s/g, '')}`}>{site.contact.phoneSchool}</a>
        &nbsp;·&nbsp;
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </p>
    </div>
  </Section>

  <Section id="weekly-schedule" title={t('school.schedule.title')} background="soft">
    <ScheduleTable lang={lang} />
    <p class="schedule-note">
      Last updated: 3 September 2026. Schedules may be subject to changes until the start of the course, scheduled for 14 September.
    </p>
  </Section>

  <MembershipCTA lang={lang} />

  <Section id="location" title={t('school.location.title')} background="soft">
    <MapEmbed lang={lang} />
  </Section>

</PageLayout>

<style>
  .school-infographic {
    max-width: 1100px;
    margin-inline: auto;
  }

  .school-infographic img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .document-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    max-width: 1000px;
    margin-inline: auto;
  }

  .document-card {
    text-align: center;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .document-card p {
    margin-block-end: var(--space-4);
    font-size: var(--text-lg);
  }

  @media (max-width: 767px) {
    .document-cards {
      grid-template-columns: 1fr;
    }
  }

  .hours-block,
  .schedule-note {
    text-align: center;
    max-width: 500px;
    margin-inline: auto;
  }
  .hours-text {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-primary-dark);
    margin-block-end: var(--space-4);
  }
  .hours-contact { font-size: var(--text-md); }
  .schedule-note {
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
</style>
