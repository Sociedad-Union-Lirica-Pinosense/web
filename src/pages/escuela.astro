---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import MapEmbed from '../components/MapEmbed.astro';
import ScheduleTable from '../components/ScheduleTable.astro';
import NewsExpandable from '../components/NewsExpandable.astro';
import MembershipCTA from '../components/MembershipCTA.astro';
import { getCollection } from 'astro:content';
import { site } from '../config/site';
import { useTranslations } from '../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);

const courses = (await getCollection('courses'))
  .filter((c) => c.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title={t('school.title')}
  description="Escuela de Música de la Sociedad Unión Lírica Pinosense — Ofertas formativas, horarios, normativa y calendario escolar."
  lang={lang}
>
  <Hero
    image={`${site.base}/images/escuela/fachada.webp`}
    alt="Fachada de la Escuela de Música de Pinoso"
    title={t('school.title')}
    compact
  />

  <Section id="noticias-escuela" title={t('school.news.title')}>
    <NewsExpandable lang={lang} limit={1} />
  </Section>

  <Section id="ofertas" title={t('school.courses.title')}>
    <div class="school-infographic">
      <img
        src={`${site.base}/images/escuela/oferta-formativa-2026-2027-es.png`}
        alt="Infografía de la estructura de la Escuela de Música de la Sociedad Unión Lírica Pinosense para el curso 2026/2027"
        loading="lazy"
        decoding="async"
      />
    </div>
  </Section>

  <Section id="matricula" title="Matrícula y calendario Curso 26-27" background="soft">
    <div class="document-cards">
      <div class="document-card">
        <p>
          Consulta toda la información sobre la matrícula del curso 2026/2027.
        </p>
        <a
          href={`${site.base}/pdfs/matricula-curso-26-27.pdf`}
          class="btn btn-outline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Abrir información de matrícula
        </a>
      </div>

      <div class="document-card">
        <p>
          Consulta el calendario escolar del curso 2026/2027.
        </p>
        <a
          href={`${site.base}/pdfs/calendario-escolar-2026-2027.pdf`}
          class="btn btn-outline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Abrir calendario 2026/2027
        </a>
      </div>
    </div>
  </Section>

  <Section id="horario-secretaria" title={t('school.hours.title')} background="soft">
    <div class="hours-block">
      <p class="hours-text">{site.hours.secretariatSchool[lang]}</p>
      <p class="hours-contact">
        <a href={`tel:${site.contact.phoneSchool.replace(/\s/g, '')}`}>
          {site.contact.phoneSchool}
        </a>
        &nbsp;·&nbsp;
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </p>
    </div>
  </Section>


  <Section id="horario-clases" title={t('school.schedule.title')} background="soft">
    <ScheduleTable lang={lang} />
    <p class="schedule-note">
      Los horarios pueden sufrir modificaciones hasta el inicio del curso, previsto para el 14 de septiembre.
    </p>
  </Section>

  <MembershipCTA lang={lang} />

 <Section id="ubicacion" title={t('school.location.title')} background="soft">
    <MapEmbed lang={lang} />
  </Section>

</PageLayout>

<style>
  .school-infographic {
    max-width: 1100px;
    margin-inline: auto;
  }

  .school-infographic img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .document-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    max-width: 1000px;
    margin-inline: auto;
  }

  .document-card {
    text-align: center;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .document-card p {
    margin-block-end: var(--space-4);
    font-size: var(--text-lg);
  }

  @media (max-width: 767px) {
    .document-cards {
      grid-template-columns: 1fr;
    }
  }

  .hours-block,
  .schedule-note {
    text-align: center;
    max-width: 500px;
    margin-inline: auto;
  }
  .hours-text {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-primary-dark);
    margin-block-end: var(--space-4);
  }
  .hours-contact {
    font-size: var(--text-md);
  }
  .schedule-note {
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
</style>
